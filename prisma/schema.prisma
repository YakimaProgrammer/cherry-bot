generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EmojiStatus {
  Ok
  UserDeleted
  AdminDeleted
  ServerDeleted
  Blocked
  UserLeft
  Expired
}

enum UserStatus {
  Ok
  Blocked
}

model Emoji {
  emojiId      String             @id
  cloudflareId String
  userId       String
  timestamp    DateTime           @default(now())
  guildId      String
  statusEvents EmojiStatusEvent[]
  usageEvents  EmojiUsageEvent[]

  @@index([userId])
  @@index([guildId])
}

model EmojiStatusEvent {
  eventId   Int         @id @default(autoincrement())
  emojiId   String
  timestamp DateTime    @default(now())
  userId    String
  status    EmojiStatus

  emoji Emoji @relation(fields: [emojiId], references: [emojiId])

  @@index([emojiId, eventId(sort: Desc)])
  @@index([userId])
}

model EmojiUsageEvent {
  eventId   Int      @id @default(autoincrement())
  emojiId   String
  timestamp DateTime @default(now())
  userId    String
  channelId String
  guildId   String

  emoji Emoji @relation(fields: [emojiId], references: [emojiId])

  @@index([emojiId, eventId(sort: Desc)])
}

model UserStatusEvent {
  eventId   Int        @id @default(autoincrement())
  timestamp DateTime   @default(now())
  userId    String
  guildId   String
  status    UserStatus

  @@index([userId, guildId, eventId(sort: Desc)])
}

model AuditEvent {
  eventId   Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  userId    String
  guildId   String
  command   String
  channelId String

  @@index([userId])
  @@index([guildId])
}

model Guild {
  guildId           String @id
  // How many emoji each user can own
  emojiPerUserLimit Int
  // How many seconds before emoji expire
  emojiExpireTime   Int
}
